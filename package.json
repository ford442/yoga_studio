{
  "name": "yoga_studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run validate:shaders && node scripts/generate-sw.mjs",
    "deploy": "python3 deploy.py",
    "build": "next build",
    "start": "npx serve@latest out -l 3000",
    "preview": "npx serve@latest out -l 3000",
    "lint": "eslint",
    "smoke:files": "node scripts/smoke-export.mjs",
    "smoke:assets": "node scripts/smoke-assets.mjs",
    "media:instructor": "node assets/video/encode.mjs",
    "smoke": "npm run smoke:files && npm run smoke:assets",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:native": "cmake -S native/gpu-chores-wasm -B native/gpu-chores-wasm/build -DCMAKE_EXPORT_COMPILE_COMMANDS=ON && cmake --build native/gpu-chores-wasm/build && ./native/gpu-chores-wasm/build/chores_test",
    "build:chores-wasm": "bash native/gpu-chores-wasm/scripts/build-wasm.sh",
    "validate:shaders": "node --import tsx scripts/validate-shaders.ts",
    "validate:content": "node --import tsx scripts/validate-content.ts",
    "audit:high": "npm audit --audit-level=high",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.scripts.json",
    "check": "npm run lint && npm run typecheck && npm run validate:shaders && npm run validate:content"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "@webgpu/types": "^0.1.74",
    "eslint": "10.11.0",
    "eslint-config-next": "16.3.5",
    "jsdom": "^30.1.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vitest": "^5.0.0"
  }
}
