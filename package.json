{
  "name": "yoga_studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run validate:shaders && node scripts/generate-sw.mjs",
    "deploy": "python3 deploy.py",
    "build": "next build",
    "start": "npx serve@latest out -l 3000",
    "preview": "npx serve@latest out -l 3000",
    "lint": "eslint --max-warnings 0",
    "smoke:files": "node scripts/smoke-export.mjs",
    "smoke:assets": "node scripts/smoke-assets.mjs",
    "media:instructor": "node assets/video/encode.mjs",
    "smoke": "npm run smoke:files && npm run smoke:assets",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:unit": "vitest run --project unit-node",
    "test:ui": "vitest run --project ui-jsdom",
    "test:native": "cd native/gpu-chores-wasm && cmake --preset host && cmake --build --preset host && ctest --preset host",
    "test:native:asan": "cd native/gpu-chores-wasm && cmake --preset host-asan && cmake --build --preset host-asan && ctest --preset host-asan",
    "test:native:tidy": "cd native/gpu-chores-wasm && cmake --preset host-tidy && cmake --build --preset host-tidy && ctest --preset host-tidy",
    "build:chores-wasm": "bash native/gpu-chores-wasm/scripts/build-wasm.sh",
    "validate:shaders": "node --import tsx scripts/validate-shaders.ts",
    "validate:content": "node --import tsx scripts/validate-content.ts",
    "audit:high": "npm audit --audit-level=high",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.scripts.json",
    "check": "npm run lint && npm run typecheck && npm run validate:shaders && npm run validate:content"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@webgpu/types": "^0.1.74",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.3",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  }
}
